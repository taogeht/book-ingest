# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/curriculum_ingest"

# Single-user auth — set to anything; first /login call hashes & stores
INGEST_PASSWORD="change-me"

# Cloudflare R2 (same account as recording-app; new bucket)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="curriculum-ingest-sources"
R2_PUBLIC_URL="https://your-r2-public-url.example"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
